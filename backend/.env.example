DATABASE_URL=postgresql://agentic:agentic@localhost:5432/agentic_life

# --- Providers -------------------------------------------------------------
# Personas name their own model (litellm provider-prefixed). Fill in whichever
# providers your personas use:

# AWS Bedrock (model: bedrock/... in personas). Uses your AWS credential chain;
# with SSO run `aws sso login --profile <profile>` first.
AWS_PROFILE=
AWS_REGION=ap-southeast-2

# Direct APIs (model: openai/... or anthropic/... in personas)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local (model: ollama/... in personas)
OLLAMA_BASE_URL=http://localhost:11434

# --- Simulation ------------------------------------------------------------
# NOTE: embedding dimension must match vector(N) in init.sql
#   bedrock/amazon.titan-embed-text-v2:0 -> 1024 (current schema)
#   text-embedding-3-small              -> 1536
EMBEDDING_MODEL=bedrock/amazon.titan-embed-text-v2:0
JUDGE_MODEL=bedrock/au.anthropic.claude-haiku-4-5-20251001-v1:0
TICK_SECONDS=12
# PERSONAS_DIR=personas
# WORLD_PATH=config/world.yaml
# CONSTITUTION_PATH=config/constitution.yaml
